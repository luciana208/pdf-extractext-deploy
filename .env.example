# copiar a .env (lo hace scripts/up.sh la primera vez) y cambiar las contraseñas
DOMAIN=pdfextractext.localhost
LOG_LEVEL=INFO

MONGO_ROOT_USERNAME=pdfadmin
MONGO_ROOT_PASSWORD=cambiar-esta-clave
DB_NAME=pdf_extraction_db

CONSUL_TOKEN=

# versiones de las imagenes (semver)
ORCHESTRATOR_VERSION=1.0.0
VALIDATION_VERSION=1.0.0
EXTRACT_VERSION=1.0.0
DOCUMENTS_VERSION=1.0.0

# replicas por servicio (el tp de carga permite hasta 5 en extract)
ORCHESTRATOR_REPLICAS=2
VALIDATION_REPLICAS=2
EXTRACT_REPLICAS=3
DOCUMENTS_REPLICAS=2

# recursos y concurrencia del extractor
EXTRACT_CPUS=1.0
EXTRACT_MEMORY=1G
EXTRACT_WORKERS=1
EXTRACT_MAX_IN_FLIGHT=8

MAX_PDF_SIZE_MB=10
EXTRACTION_TIMEOUT=60
RESERVATION_TTL_SECONDS=300

TRAEFIK_RETRY_ATTEMPTS=3
TRAEFIK_RETRY_INTERVAL=100ms
