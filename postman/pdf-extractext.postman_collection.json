    {
      "name": "11 extract directo (tp de carga)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('content y page_count', () => { const b = pm.response.json(); pm.expect(b).to.have.property('content'); pm.expect(b.page_count).to.be.above(0); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{extractUrl}}/extract?format=markdown",
          "host": [
            "{{extractUrl}}"
          ],
          "path": [
            "extract"
          ],
          "query": [
            {
              "key": "format",
              "value": "markdown"
            }
