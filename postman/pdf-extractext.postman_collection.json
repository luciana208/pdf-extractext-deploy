{
  "info": {
    "_postman_id": "34bc671a-6e8b-4236-91e0-f47aaea930d4",
    "name": "PDF-extractext microservicios",
    "description": "Prueba punta a punta: subir, consultar, renombrar, descargar y borrar a traves del orquestador. Correr en orden. Si Postman rechaza el certificado, desactivar SSL certificate verification o importar la CA de mkcert.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 health orquestador",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('dependencias ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": ""
      }
    },
    {
      "name": "02 subir pdf",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('documentId', body.id);",
              "pm.test('trae checksum y texto', () => { pm.expect(body.checksum).to.have.lengthOf(64); pm.expect(body).to.have.property('extracted_text'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/documents/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "documents"
          ]
        },
        "description": "Seleccionar el PDF en el campo file. Corre la saga completa.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "",
              "description": "elegir un PDF"
            },
            {
              "key": "custom_name",
              "type": "text",
              "value": "",
              "disabled": true
            }
          ]
        }
      }
    },
    {
      "name": "03 subir el mismo pdf (duplicado)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 409', () => pm.response.to.have.status(409));",
              "pm.test('problem+json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/documents/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "documents"
          ]
        },
        "description": "Mismo archivo que en 02.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "",
              "description": "elegir un PDF"
            },
            {
              "key": "custom_name",
              "type": "text",
              "value": "",
              "disabled": true
            }
          ]
        }
      }
    },
    {
      "name": "04 subir un archivo que no es pdf",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/documents/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "documents"
          ]
        },
        "description": "",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "",
              "description": "elegir un archivo que NO sea PDF (un .txt o .docx)"
            }
          ]
        }
      }
    },
    {
      "name": "05 listar",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('incluye el subido', () => pm.expect(pm.response.json().map(d => d.id)).to.include(pm.collectionVariables.get('documentId')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/documents/?skip=0&limit=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "documents"
          ],
          "query": [
            {
              "key": "skip",
              "value": "0"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        },
        "description": ""
      }
    },
    {
      "name": "06 obtener por id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/documents/{{documentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "documents",
            "{{documentId}}"
          ]
        },
        "description": ""
      }
    },
    {
      "name": "07 renombrar",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('nombre nuevo', () => pm.expect(pm.response.json().name).to.eql('renombrado.pdf'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/documents/{{documentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "documents",
            "{{documentId}}"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\"custom_name\": \"renombrado.pdf\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "08 descargar txt",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('adjunto txt', () => pm.expect(pm.response.headers.get('Content-Disposition')).to.include('.txt'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
